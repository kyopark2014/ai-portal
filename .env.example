# Google OAuth Web client ID (공개 값). Authorized JavaScript origins 에 포털 오리진을 추가해야 합니다.
GOOGLE_CLIENT_ID=
# 쉼표로 구분한 관리자 이메일. 나머지 로그인 사용자는 일반 사용자.
ADMIN_EMAILS=e2npark@gmail.com
# 세션 쿠키 서명 키. 비우면 application/data/.session_signing_key 에 자동 생성(로컬 전용).
# ECS 에서는 Secrets Manager 로 주입하세요(여러 태스크가 같은 키를 써야 합니다).
SESSION_SIGNING_KEY=
SESSION_MAX_AGE_SECONDS=86400
# https 뒤에서는 1 (CloudFront/ALB). 로컬 http 개발은 0.
COOKIE_SECURE=0
# 로컬 개발 시 Swagger UI(/docs) 노출
ENABLE_API_DOCS=0

# AWSome AI Gateway (프롬프트 테스트). 키는 서버에만 두며 브라우저로 나가지 않는다.
LLM_GATEWAY_URL=https://llm.my-agentic-ai.click
LLM_GATEWAY_KEY=

# 승인 요청 메일의 링크 기준 주소(배포 오리진). 비우면 config.json 의 sharing_url, 없으면 http://localhost:8501
PORTAL_ORIGIN=

# MCP Gateway 를 가져올 리전(쉼표 구분). 비우면 AWS_REGION + us-east-1
GATEWAY_REGIONS=

# 저장소: 비워 두면 DynamoDB(배포·로컬 공통, 서버와 같은 데이터가 보인다). sqlite 는 테스트 전용이다.
PORTAL_STORE=dynamodb
DDB_TABLE=ai-portal
AWS_REGION=us-west-2
